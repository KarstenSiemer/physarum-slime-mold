{
  "name": "physarum-slime-mold",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive GPU simulation of the slime mold Physarum polycephalum in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26",
    "npm": ">=11.10"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:gpu": "vitest run --project gpu",
    "test:e2e": "playwright test --project e2e",
    "verify": "npm run lint && npm run check && npm test && npm run test:gpu && npm run build && npm run test:e2e",
    "gallery": "playwright test --project gallery"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "playwright": "1.65.0",
    "prettier": "3.10.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "svelte": "5.57.3"
  }
}
